# Where the content store (content.json), uploads and the session key live.
# Must be a persistent disk in production. Defaults to ./data
DATA_DIR=./data

# Optional: signing secret for admin sessions (32+ random chars).
# If unset, one is generated and saved inside DATA_DIR on first run.
SESSION_SECRET=

# Optional: public URL of the site, used for sitemap and social previews.
SITE_URL=https://solvia.tech

# Email notifications for enquiries / "get in touch" queries (Resend)
# Get your free API key at https://resend.com
RESEND_API_KEY=
# The email address (Gmail, etc.) where new enquiries should be sent
NOTIFICATION_EMAIL=
# Optional: custom sender (defaults to "Solvia Technologies <onboarding@resend.dev>")
FROM_EMAIL=

